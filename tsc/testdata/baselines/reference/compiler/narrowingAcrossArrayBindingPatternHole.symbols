=== narrowingAcrossArrayBindingPatternHole.ts ===
// The hole in the array binding pattern is a binding element without a name; the
// flow path from the narrowed use of `value` crosses its assignment node.
declare const pair: [number, string];
>pair : Symbol(pair, Decl(narrowingAcrossArrayBindingPatternHole.ts, 2, 13))

function narrowAcrossHole(value: string | number) {
>narrowAcrossHole : Symbol(narrowAcrossHole, Decl(narrowingAcrossArrayBindingPatternHole.ts, 2, 37))
>value : Symbol(value, Decl(narrowingAcrossArrayBindingPatternHole.ts, 4, 26))

    value = "text";
>value : Symbol(value, Decl(narrowingAcrossArrayBindingPatternHole.ts, 4, 26))

    const [, second] = pair;
>second : Symbol(second, Decl(narrowingAcrossArrayBindingPatternHole.ts, 6, 12))
>pair : Symbol(pair, Decl(narrowingAcrossArrayBindingPatternHole.ts, 2, 13))

    const narrowed: string = value;
>narrowed : Symbol(narrowed, Decl(narrowingAcrossArrayBindingPatternHole.ts, 7, 9))
>value : Symbol(value, Decl(narrowingAcrossArrayBindingPatternHole.ts, 4, 26))

    return narrowed + second;
>narrowed : Symbol(narrowed, Decl(narrowingAcrossArrayBindingPatternHole.ts, 7, 9))
>second : Symbol(second, Decl(narrowingAcrossArrayBindingPatternHole.ts, 6, 12))
}

